# Left unset in dev on purpose - useStore.js/ChatAssistantDialog.jsx fall
# back to http://<page's own hostname>:5000, which works whether you load
# the app via localhost, a WSL IP, or your machine's LAN IP from a phone.
# Set this explicitly only to override that (e.g. for a prod build).
VITE_TM_BACKEND_URL=http://127.0.0.1:5000
